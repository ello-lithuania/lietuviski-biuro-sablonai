% \vardadienis{month}{day}: the names of that day.
\newcommand\vardadienis[2]{%
  \@ifundefined{vd@\two@digits{#1}-\two@digits{#2}}%
    {\PackageError{vardadieniai}{No such date: #1-#2}{Give the month and the day as numbers.}}%
    {\@nameuse{vd@\two@digits{#1}-\two@digits{#2}}}}

% \vardadieniaisiandien: the names of today, taken from \today's counters.
\newcommand\vardadieniaisiandien{\vardadienis{\month}{\day}}

% \vardodienos{name}: the days of a name.
\newcommand\vardodienos[1]{%
  \expandafter\ifx\csname vdv@\detokenize{#1}\endcsname\relax
    \PackageWarning{vardadieniai}{Name #1 is not in the calendar}%
  \else
    \csname vdv@\detokenize{#1}\endcsname
  \fi}

% \vardadieniumenuo{month}: a list with every day of a month.
\newcount\vd@diena
\newcommand\vardadieniumenuo[1]{%
  \par\begingroup
  \parindent\z@ \parskip 2\p@ \raggedright
  \vd@diena\@ne
  \loop
    \@ifundefined{vd@\two@digits{#1}-\two@digits{\vd@diena}}%
      {\let\vd@toliau\iffalse}%
      {\let\vd@toliau\iftrue
       \textbf{\the\vd@diena}\enspace
       \@nameuse{vd@\two@digits{#1}-\two@digits{\vd@diena}}\par}%
    \advance\vd@diena\@ne
  \vd@toliau\repeat
  \endgroup\par}

